 #[test]
+#[cfg(all(feature = "std", any(unix, target_os = "motor")))]
+fn motor_compatible_file_paths() {
+    use std::path::Path;
+
+    for (path, encoded) in [
+        ("/", "file:///"),
+        ("/a b/%/#/é.rs", "file:///a%20b/%25/%23/%C3%A9.rs"),
+        ("/a\\b", "file:///a%5Cb"),
+    ] {
+        let url = Url::from_file_path(path).unwrap();
+        assert_eq!(url.as_str(), encoded);
+        assert_eq!(url.to_file_path().unwrap(), Path::new(path));
+    }
+    for path in ["", "relative", "../relative"] {
+        assert!(Url::from_file_path(path).is_err());
+        assert!(Url::from_directory_path(path).is_err());
+    }
+    assert_eq!(
+        Url::from_directory_path("/a b").unwrap().as_str(),
+        "file:///a%20b/"
+    );
+    assert_eq!(
+        Url::parse("file://localhost/a")
+            .unwrap()
+            .to_file_path()
+            .unwrap(),
+        Path::new("/a")
+    );
+    for url in [
+        "file://remote/a",
+        "https://example.com/a",
+        "data:text/plain,a",
+    ] {
+        assert!(Url::parse(url).unwrap().to_file_path().is_err());
+    }
+    #[cfg(target_os = "motor")]
+    assert!(Url::parse("file:///bad%FF")
+        .unwrap()
+        .to_file_path()
+        .is_err());
+}
