version = 1

[provider]
base_url = "HUMAN_REQUIRED_HTTPS_PROVIDER_URL"
model = "HUMAN_REQUIRED_EXACT_MODEL_AND_VERSION"
key_file = "HUMAN_REQUIRED_CREDENTIAL_PATH"

[net]
egress_allowlist = ["HUMAN_REQUIRED_PROVIDER_HOST"]

[permissions]
mode = "ask"

[limits]
max_steps = 64
# Fail closed until a human supplies positive finite values within the
# ceilings in manifest.toml.
budget_usd = 0.0
budget_tokens = 0

[agents]
max_depth = 1
max_concurrent = 2

[context]
budget_tokens = 128000
summarize = true
