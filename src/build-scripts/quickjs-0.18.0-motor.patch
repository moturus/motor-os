+    registry = moto_rt_poll_new();
+    if (registry < 0) {
+        error = registry;
+        goto fail;
+    }
+    for (int i = 0; i < count; i++) {
+        uint64_t interests = 0;
+        if (fds[i].events & POLLIN)
+            interests |= MOTO_POLL_READABLE;
+        if (fds[i].events & POLLOUT)
+            interests |= MOTO_POLL_WRITABLE;
+        error = moto_rt_poll_add(registry, fds[i].fd, i, interests);
+        if (error == -MOTO_E_INVALID_ARGUMENT) {
+            /* Regular files are always ready, as in libc poll(). */
+            fds[i].revents = fds[i].events;
+            ready = true;
+        } else if (error < 0) {
+            goto fail;
+        }
+    }
