+static int js_motor_poll(JSContext *ctx, struct pollfd *fds, int count,
+                         int timeout_ms, int flags)
+{
+    JSThreadState *ts = js_get_thread_state(JS_GetRuntime(ctx));
+    struct list_head *el;
